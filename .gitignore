# ---------------------------------------------------------------------------
# Rush-Decomp .gitignore
#
# HARD RULE: nothing derived from a Sonic Rush cartridge image may ever be
# committed.  That means the ROM itself, the extracted binaries, the
# disassembly, the file system contents, the graphics/audio dumps and the
# build outputs.  Every one of those lives in a directory that is ignored
# here and is regenerated locally by `make setup`.
# ---------------------------------------------------------------------------

# --- Copyrighted input: the user's own cartridge dump -----------------------
baserom/**
!baserom/.gitkeep
*.nds
*.srl
*.ds
*.nd
*.srl.nds
*.dsg
*.bin.gz
*.zip
*.7z
*.rar

# Keep the synthetic self-test ROM out of the binary-extension rule; it is
# original code generated by tests/make_test_rom.py, never a retail dump.
!tests/data/testrom.nds

# --- Generated extraction output -------------------------------------------
# Raw ARM9/ARM7/overlay binaries split out of the cartridge image.
data/**
!data/.gitkeep

# Auto-generated disassembly.  Hand-written reconstruction goes in src/.
asm/**
!asm/.gitkeep

# Nitro ROM file system dump (models, textures, scripts, sound archives...).
fsdump/**

# Build products.
build/**
!build/.gitkeep
*.o
*.a
*.elf
*.map
*.d
*.lst

# --- Toolchain state --------------------------------------------------------
tools/.cache/**
tools/bin/**
*.pyc
__pycache__/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Keys / secrets ---------------------------------------------------------
# The Nintendo KEY1 blob is itself copyrighted firmware data.  It is never
# committed; supply your own if you want secure-area decryption.
tools/keys/**
*.key
*.pem

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
