#!/usr/bin/env python3
"""Rush-Decomp toolchain entry point.

Thin wrapper so `tools/sr <verb>` works from a clean checkout with nothing but
Python and the two pip dependencies installed.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__))))

from rushdecomp.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
